#
# Layout: one block per host for what differs (address, key), then one block
# per group for the settings the group shares. A Host line can list several
# hosts. ssh uses the first value it finds for most settings, but IdentityFile
# adds up across blocks, so keys are only set where they differ.
#

#
# git hosts
#
Host bitbucket.org
    User danielt
    IdentityFile ~/.ssh/keys/kinsol/id_rsa_bitbucket_danielt

# kinsol github; ~/kinsol/ repos are rewritten to this (see ~/.config/git/kinsol-dir.gitconfig)
Host github.com-kinsol
    HostName github.com
    User git
    IdentityFile ~/.ssh/keys/kinsol/id_rsa_github_dtempleman
    IdentitiesOnly yes

#
# kinsol dev servers, as danielt
#
Host hector
    HostName 192.168.5.13
    IdentityFile ~/.ssh/keys/kinsol/id_rsa_foghorn_danielt

Host talos
    IdentityFile ~/.ssh/keys/kinsol/id_rsa_talos_danielt

Host foghorn
    IdentityFile ~/.ssh/keys/kinsol/id_rsa_foghorn_danielt

Host dot
    IdentityFile ~/.ssh/keys/kinsol/id_rsa_dot_danielt

Host ix
    HostName 192.168.5.15
    IdentityFile ~/.ssh/keys/kinsol/id_rsa_foghorn_danielt

Host hector talos foghorn dot ix
    User danielt
    IdentitiesOnly yes
    ForwardAgent yes

# ForwardAgent only forwards keys loaded in the local agent, which starts
# empty: load the kinsol git keys just before connecting to a dev server.
# originalhost matches the name you typed (host would match the HostName IP).
Match originalhost hector,talos,foghorn,dot,ix exec "ssh-add -q ~/.ssh/keys/kinsol/id_rsa_github_dtempleman ~/.ssh/keys/kinsol/id_rsa_bitbucket_danielt 2>/dev/null; true"

#
# kinsol servers, ADMIN creds
#
Host admin-hector
    HostName 192.168.5.13

Host admin-talos
    HostName 192.168.5.14

Host admin-foghorn
    HostName 192.168.5.11

Host admin-dot
    HostName 192.168.5.12

Host admin-ix
    HostName 192.168.5.15

## not sure the ip of this one
Host admin-etna
    # HostName 192.168.5.17

Host admin-hector admin-talos admin-foghorn admin-dot admin-ix admin-etna
    IdentityFile ~/.ssh/keys/kinsol/id_ed25519_admin_kinsol

## network gateway (own key)
Host admin-wolf
    HostName 192.168.5.1
    IdentityFile ~/.ssh/keys/kinsol/id_rsa_wolf_kinsol

Host admin-*
    User kinsol
    IdentitiesOnly yes

#
# Kinsol services
#
Host vault
    HostName vault.kinsol.io
    User ubuntu
    IdentityFile ~/.ssh/keys/kinsol/id_ed25519_vault_kinsol
    IdentitiesOnly yes

#
# Slipstream wilderness firstaid
#
Host wilderness-production
    HostName ec2-54-190-163-73.us-west-2.compute.amazonaws.com

Host wilderness-staging
    HostName ec2-52-10-122-174.us-west-2.compute.amazonaws.com

Host wilderness-*
    User ubuntu
    IdentityFile ~/.ssh/keys/clients/SlipstreamWordpress.pem
    IdentitiesOnly yes

#
# Schneider Electric - Meter insights
#
Host schneider-staging
    HostName ec2-35-87-101-223.us-west-2.compute.amazonaws.com

Host schneider-production
    HostName ec2-52-42-215-246.us-west-2.compute.amazonaws.com

Host schneider-*
    User ubuntu
    IdentityFile ~/.ssh/keys/clients/Schneider.pem
    IdentitiesOnly yes
    PubkeyAcceptedAlgorithms +ssh-rsa

#
# Element Human - events database
#
Host element-human
    HostName gateway.elementhuman.com
    User dtempleman
    IdentityFile ~/.ssh/keys/clients/id_rsa_elementhuman_dtempleman
