# copy to ~/.ssh/config.local and keep ONE IdentityFile uncommented
# sets which key plain git@github.com: uses outside ~/kinsol/ and ~/kemple/
Host github.com
	IdentityFile ~/.ssh/id_rsa_github_dtempleman            # work machine (kinsol)
#	IdentityFile ~/.ssh/id_rsa_github_daniel_personal       # personal machine (personal)
	IdentitiesOnly yes
