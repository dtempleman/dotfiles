# machine default identity, set per machine in ~/.gitconfig.local (not in this repo)
# see .gitconfig.local.example
[include]
	path = ~/.gitconfig.local

# folder overrides; these come after the machine default so they win
# note: the machine default must NOT add url.insteadOf rewrites for github.com,
# because git uses the FIRST matching rewrite and these would no longer apply
[includeIf "gitdir:~/kinsol/"]
	path = ~/.config/git/kinsol-dir.gitconfig
[includeIf "gitdir:~/kemple/"]
	path = ~/.config/git/kemple-dir.gitconfig
